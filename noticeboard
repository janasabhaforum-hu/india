<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mannanam Janasabha - Notice Board</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>

/* ===== RESET ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: "Poppins", sans-serif;
}

/* ===== NAVBAR ===== */
nav {
  background: #1b1b1b;
  height: 70px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40px;
  position: fixed;
  top: 0;
  z-index: 1000;
}

.logo {
  color: white;
  font-size: 28px;
  font-weight: 700;
}

nav ul {
  display: flex;
  list-style: none;
}

nav ul li {
  margin: 0 12px;
}

nav ul li a {
  color: white;
  text-decoration: none;
}

nav ul li a:hover,
nav ul li a.active {
  color: yellow;
}

/* MOBILE MENU */
.menu-toggle {
  display: none;
  font-size: 24px;
  color: white;
  background: none;
  border: none;
  cursor: pointer;
}

@media (max-width: 900px) {
  nav ul { display: none; }
  .menu-toggle { display: block; }
}

/* ===== LANGUAGE ===== */
.language-dropdown {
  position: relative;
}

.lang-btn {
  background: #1b1b1b;
  color: white;
  border: 1px solid #f1c40f;
  padding: 6px 12px;
  border-radius: 20px;
  cursor: pointer;
}

.lang-menu {
  display: none;
  position: absolute;
  right: 0;
  top: 40px;
  background: white;
  border-radius: 8px;
  min-width: 160px;
}

.lang-menu a {
  display: block;
  padding: 10px;
  text-decoration: none;
  color: #333;
}

.lang-menu a:hover {
  background: #f1c40f;
}

.language-dropdown.active .lang-menu {
  display: block;
}

/* ===== MOBILE SIDE MENU ===== */
.menu-overlay {
  position: fixed;
  inset: 0;
  display: none;
  z-index: 1200;
}

.menu-overlay.show {
  display: flex;
}

.menu-overlay::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.5);
}

.side-menu {
  width: 200px;
  background: #333;
  color: white;
  padding: 20px;
  transform: translateX(-100%);
  transition: 0.3s;
}

.menu-overlay.show .side-menu {
  transform: translateX(0);
}

.side-menu ul {
  list-style: none;
}

.side-menu ul li {
  margin: 15px 0;
}

.side-menu a {
  color: white;
  text-decoration: none;
}

.close-btn {
  font-size: 25px;
  background: none;
  border: none;
  color: white;
  float: right;
  cursor: pointer;
}

/* ===== NOTICEBOARD ===== */
/* ===== NOTICEBOARD (FIXED) ===== */
.noticeboard {
  margin-top: 90px;   /* 👈 prevents navbar overlap */
  background: #d7f5d7;
  padding: 50px 20px;
  text-align: center;
}

.noticeboard h2 {
  font-size: 2rem;
  margin-bottom: 10px;
}

.intro {
  margin-bottom: 30px;
  color: #555;
}

/* STACK CARDS VERTICALLY */
.noticeboard-grid {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 25px;
}

/* CARD */
.noticeboard-card {
  background: white;
  padding: 30px;
  border-radius: 15px;
  width: 90%;
  max-width: 800px;
  box-shadow: 0 5px 15px rgba(0,0,0,0.1);
  text-align: left;
}

.noticeboard-card h3 {
  text-align: center;
  margin-bottom: 20px;
}

/* PARAGRAPH ALIGNMENT */
.noticeboard-card p {
  text-align: justify;
  line-height: 1.7;
}

/* ===== FOOTER ===== */
.footer {
  background: #2c3e50;
  color: white;
  padding: 30px;
  text-align: center;
}

</style>
</head>

<body>

<!-- NAVBAR -->
<nav>
  <div class="logo">Janasabha</div>

  <ul>
    <li><a href="#">Home</a></li>
    <li><a href="#" class="active">Notice</a></li>
  </ul>

  <div class="language-dropdown">
    <button class="lang-btn">🌐</button>
    <div class="lang-menu">
      <a href="#" data-lang="en">English</a>
      <a href="#" data-lang="ml">Malayalam</a>
    </div>
  </div>

  <button class="menu-toggle" id="openMenuBtn">
    <i class="fa fa-bars"></i>
  </button>
</nav>

<!-- MOBILE MENU -->
<div class="menu-overlay" id="menuOverlay">
  <div class="side-menu">
    <button class="close-btn" id="closeMenuBtn">&times;</button>
    <ul>
      <li><a href="#">Home</a></li>
      <li><a href="#">Notice</a></li>
    </ul>
  </div>
</div>

<!-- NOTICEBOARD -->
<!-- NOTICEBOARD -->
<section class="noticeboard">

  <h2>Notice Board</h2>
  <p class="intro"><strong>Welcome to Janasabha Volunteers Forum</strong></p>

  <div class="noticeboard-grid">

    <!-- CARD 1 -->
    <div class="noticeboard-card">
      <h3>Volunteer Registration</h3>
      <p>
        Are you interested in becoming a Janasabha volunteer or a community
        development worker? Janasabha invites individuals who are willing to
        contribute their time, skills, and ideas for the development of local
        communities.
        <br><br>

        👉 Become a Janasabha organizer<br>
        👉 Start Janasabha in your area<br>
        👉 Be part of your locality’s development
        <br><br>

        Visit:
        <a href="https://www.janasabha.org.in" target="_blank">
          www.janasabha.org.in
        </a>
      </p>
    </div>

    <!-- CARD 2 -->
    <div class="noticeboard-card">
      <h3>E-Magazine Naming Contest</h3>
      <p>
        Suggest a name for the Janasabha e-magazine and win an attractive prize.
        <br><br>

        If multiple people suggest the same name, the winner will be chosen by a draw.
        <br><br>

        Submit here:
        <a href="https://forms.gle/PWVrkTUU7NPjfHCj6" target="_blank">
          Click to Submit
        </a>
        <br><br>

        <strong>Last Date: 30th May 2026</strong>
      </p>
    </div>

  </div> <!-- ✅ FIXED: CLOSED DIV -->

</section>

<!-- FOOTER -->
<footer class="footer">
  <p>© 2026 Mannanam Janasabha</p>
</footer>

<!-- SCRIPT -->
<script>

// MOBILE MENU
const openBtn = document.getElementById("openMenuBtn");
const closeBtn = document.getElementById("closeMenuBtn");
const overlay = document.getElementById("menuOverlay");

openBtn.onclick = () => overlay.classList.add("show");
closeBtn.onclick = () => overlay.classList.remove("show");
overlay.onclick = (e) => {
  if (e.target === overlay) overlay.classList.remove("show");
};

// LANGUAGE
const langBtn = document.querySelector('.lang-btn');
const dropdown = document.querySelector('.language-dropdown');

langBtn.onclick = () => dropdown.classList.toggle('active');

document.addEventListener('click', (e) => {
  if (!dropdown.contains(e.target)) {
    dropdown.classList.remove('active');
  }
});

// GOOGLE TRANSLATE
document.querySelectorAll(".lang-menu a").forEach(item => {
  item.onclick = function(e) {
    e.preventDefault();
    let lang = this.dataset.lang;
    let url = encodeURIComponent(window.location.href);
    window.open(`https://translate.google.com/translate?sl=auto&tl=${lang}&u=${url}`);
  };
});

</script>

</body>
</html>
